# RUN: llc -mtriple=c166-none-elf -run-pass=postrapseudos -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=c166-none-elf -run-pass=postrapseudos -o - %s | llc -x mir -mtriple=c166-none-elf -start-after=postrapseudos -verify-machineinstrs -o - | FileCheck %s --check-prefix=ASM

# ASM-LABEL: _carry_copy_roundtrip:
# ASM: bmov psw.11, r6.0
# ASM-NEXT: mov r4, #0
# ASM-NEXT: addc r4, #0
# ASM-NEXT: rets

--- |
  define void @carry_copy_roundtrip() { ret void }
...
---
name: carry_copy_roundtrip
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6
    $c = COPY $r6
    $r4 = COPY killed $c
    RETS implicit $r4
...
# Copy bit zero of r6 into PSW.C, then materialize it as 0 or 1.
# CHECK-LABEL: name: carry_copy_roundtrip
# CHECK: BMOV 2187, 3936, implicit-def $psw, implicit-def $c, implicit $r6
# CHECK-NEXT: $r4 = MOVri4 0, implicit-def $psw
# CHECK-NEXT: $r4 = ADDCri3 $r4, 0,
# CHECK-NEXT: RETS implicit $r4
