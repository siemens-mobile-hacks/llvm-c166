# RUN: llc -mtriple=c166-none-elf -run-pass=c166-post-ra \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s

--- |
  target triple = "c166-none-elf"

  define void @forward_same_register() { ret void }
  define void @forward_same_register_short() { ret void }
  define void @forward_to_register() { ret void }
  define void @keep_unprofitable_short_copy() { ret void }
  define void @keep_different_offset() { ret void }
  define void @keep_volatile_accesses() { ret void }
  define void @keep_extension_window() { ret void }
...
---
name:            forward_same_register
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r3

    MOVmr16 $r0, 44, killed $r3, implicit-def dead $psw :: (store (s16))
    $r3 = MOVrm16 $r0, 44, implicit-def $psw :: (load (s16))
    RETS implicit $r3, implicit $psw

# CHECK-LABEL: name: forward_same_register
# CHECK:       MOVmr16 $r0, 44, $r3, implicit-def $psw
# CHECK-NEXT:  RETS implicit $r3, implicit $psw
# CHECK-NOT:   MOVrm16
...
---
name:            forward_same_register_short
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r3

    MOVmr $r0, killed $r3, implicit-def dead $psw :: (store (s16))
    $r3 = MOVrm $r0, implicit-def dead $psw :: (load (s16))
    RETS implicit $r3

# CHECK-LABEL: name: forward_same_register_short
# CHECK:       MOVmr $r0, $r3, implicit-def dead $psw
# CHECK-NEXT:  RETS implicit $r3
# CHECK-NOT:   MOVrm
...
---
name:            forward_to_register
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r3

    MOVmr16 $r0, 44, killed $r3, implicit-def dead $psw :: (store (s16))
    $r4 = MOVrm16 $r0, 44, implicit-def dead $psw :: (load (s16))
    RETS implicit $r4

# CHECK-LABEL: name: forward_to_register
# CHECK:       MOVmr16 $r0, 44, $r3, implicit-def dead $psw
# CHECK-NEXT:  $r4 = MOVrr killed $r3, implicit-def dead $psw
# CHECK-NEXT:  RETS implicit $r4
...
---
name:            keep_unprofitable_short_copy
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r3

    MOVmr $r0, killed $r3, implicit-def dead $psw :: (store (s16))
    $r4 = MOVrm $r0, implicit-def dead $psw :: (load (s16))
    RETS implicit $r4

# CHECK-LABEL: name: keep_unprofitable_short_copy
# CHECK:       MOVmr $r0, killed $r3
# CHECK-NEXT:  $r4 = MOVrm $r0
...
---
name:            keep_different_offset
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r3

    MOVmr16 $r0, 42, killed $r3, implicit-def dead $psw :: (store (s16))
    $r3 = MOVrm16 $r0, 44, implicit-def dead $psw :: (load (s16))
    RETS implicit $r3

# CHECK-LABEL: name: keep_different_offset
# CHECK:       MOVmr16 $r0, 42, killed $r3
# CHECK-NEXT:  $r3 = MOVrm16 $r0, 44
...
---
name:            keep_volatile_accesses
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r3

    MOVmr16 $r0, 44, killed $r3, implicit-def dead $psw :: (volatile store (s16))
    $r3 = MOVrm16 $r0, 44, implicit-def dead $psw :: (volatile load (s16))
    RETS implicit $r3

# CHECK-LABEL: name: keep_volatile_accesses
# CHECK:       MOVmr16 $r0, 44, killed $r3
# CHECK-NEXT:  $r3 = MOVrm16 $r0, 44
...
---
name:            keep_extension_window
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r3, $r13

    EXTPr $r13, 2
    MOVmr16 $r0, 44, killed $r3, implicit-def dead $psw :: (store (s16))
    $r3 = MOVrm16 $r0, 44, implicit-def dead $psw :: (load (s16))
    RETS implicit $r3

# CHECK-LABEL: name: keep_extension_window
# CHECK:       EXTPr $r13, 2
# CHECK-NEXT:  MOVmr16 $r0, 44, killed $r3
# CHECK-NEXT:  $r3 = MOVrm16 $r0, 44
...
