# RUN: llc -mtriple=c166-none-elf -run-pass=c166-post-ra \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s

--- |
  target triple = "c166-none-elf"

  define void @reuse_register_compare_carry() { ret void }
  define void @reuse_immediate_compare_flags() { ret void }
  define void @different_compare_operands() { ret void }
  define void @compare_after_instruction() { ret void }
  define void @compare_move_live_on_other_edge() { ret void }
  define void @compare_move_defines_operand() { ret void }
  define void @compare_after_predecessor_instruction() { ret void }
  define void @compare_with_multiple_predecessors() { ret void }
  define void @compare_in_extension_window() { ret void }
...
---
name:            reuse_register_compare_carry
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2

    CMPrr $r1, $r2, implicit-def $psw, implicit-def $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    successors: %bb.3
    liveins: $r1, $r2

    CMPrr killed $r1, killed $r2, implicit-def dead $psw, implicit-def $c
    JMPR_UC %bb.3

  bb.2:
    RETS

  bb.3:
    liveins: $r3, $c
    dead $r3 = ADDCri3 $r3, 0, implicit-def dead $psw, implicit-def dead $c, implicit $psw, implicit killed $c
    RETS

# CHECK-LABEL: name: reuse_register_compare_carry
# CHECK:       CMPrr $r1, $r2, implicit-def $psw, implicit-def $c
# CHECK-NEXT:  JMPR_EQ %bb.2, implicit $psw
# CHECK:       bb.1:
# CHECK:       liveins: {{.*}}$c
# CHECK:       JMPR_UC %bb.3
# CHECK-NOT:   CMPrr
...
---
name:            reuse_immediate_compare_flags
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r4

    CMPri16 $r4, 4660, implicit-def $psw, implicit-def dead $c
    JMPR_NE %bb.2, implicit $psw

  bb.1:
    successors: %bb.2, %bb.3
    liveins: $r4

    CMPri16 killed $r4, 4660, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.3, implicit $psw

  bb.2:
    RETS

  bb.3:
    RETS

# CHECK-LABEL: name: reuse_immediate_compare_flags
# CHECK:       CMPri16 $r4, 4660, implicit-def $psw, implicit-def dead $c
# CHECK-NEXT:  JMPR_NE %bb.2, implicit $psw
# CHECK:       bb.1:
# CHECK:       liveins: {{.*}}$psw
# CHECK:       JMPR_EQ %bb.3, implicit $psw
# CHECK-NOT:   CMPri16
...
---
name:            different_compare_operands
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r3

    CMPrr $r1, $r2, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    successors: %bb.2
    liveins: $r1, $r3

    CMPrr killed $r1, killed $r3, implicit-def dead $psw, implicit-def dead $c
    JMPR_UC %bb.2

  bb.2:
    RETS

# CHECK-LABEL: name: different_compare_operands
# CHECK:       bb.1:
# CHECK:       CMPrr killed $r1, killed $r3
...
---
name:            compare_after_instruction
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r3

    CMPrr $r1, $r2, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    successors: %bb.2, %bb.3
    liveins: $r1, $r2, $r3

    $r4 = MOVrr killed $r3, implicit-def dead $psw
    CMPrr killed $r1, killed $r2, implicit-def $psw, implicit-def dead $c
    JMPR_NE %bb.3, implicit $psw

  bb.2:
    RETS

  bb.3:
    liveins: $r4
    RETS implicit $r4

# CHECK-LABEL: name: compare_after_instruction
# CHECK:       bb.0:
# CHECK:       $r4 = MOVrr $r3
# CHECK-NEXT:  CMPrr $r1, $r2
# CHECK-NEXT:  JMPR_EQ %bb.2, implicit $psw
# CHECK:       bb.1:
# CHECK:       liveins: {{.*}}$r4{{.*}}$psw
# CHECK-NOT:   MOVrr
# CHECK-NOT:   CMPrr
# CHECK:       JMPR_NE %bb.3, implicit $psw
...
---
name:            compare_move_live_on_other_edge
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r3, $r4

    CMPrr $r1, $r2, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    successors: %bb.3
    liveins: $r1, $r2, $r3

    $r4 = MOVrr killed $r3, implicit-def dead $psw
    CMPrr killed $r1, killed $r2, implicit-def dead $psw, implicit-def dead $c
    JMPR_UC %bb.3

  bb.2:
    liveins: $r4
    RETS implicit $r4

  bb.3:
    liveins: $r4
    RETS implicit $r4

# CHECK-LABEL: name: compare_move_live_on_other_edge
# CHECK:       bb.1:
# CHECK:       $r4 = MOVrr killed $r3
# CHECK-NEXT:  CMPrr killed $r1, killed $r2
...
---
name:            compare_move_defines_operand
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r3

    CMPrr $r1, $r2, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    successors: %bb.2
    liveins: $r1, $r2, $r3

    $r1 = MOVrr killed $r3, implicit-def dead $psw
    CMPrr killed $r1, killed $r2, implicit-def dead $psw, implicit-def dead $c
    JMPR_UC %bb.2

  bb.2:
    RETS

# CHECK-LABEL: name: compare_move_defines_operand
# CHECK:       bb.1:
# CHECK:       $r1 = MOVrr killed $r3
# CHECK-NEXT:  CMPrr killed $r1, killed $r2
...
---
name:            compare_after_predecessor_instruction
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $r1, $r2, $r3

    CMPrr $r1, $r2, implicit-def dead $psw, implicit-def dead $c
    $r4 = MOVrr killed $r3, implicit-def dead $psw
    JMPR_UC %bb.1

  bb.1:
    successors: %bb.2
    liveins: $r1, $r2, $r4

    CMPrr killed $r1, killed $r2, implicit-def dead $psw, implicit-def dead $c
    RETS implicit $r4

  bb.2:
    RETS

# CHECK-LABEL: name: compare_after_predecessor_instruction
# CHECK:       CMPrr $r1, $r2
# CHECK-NEXT:  $r4 = MOVrr killed $r3
# CHECK-NEXT:  JMPR_UC %bb.1
# CHECK:       bb.1:
# CHECK:       CMPrr killed $r1, killed $r2
...
---
name:            compare_with_multiple_predecessors
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.2
    liveins: $r1, $r2

    CMPrr $r1, $r2, implicit-def $psw, implicit-def dead $c
    JMPR_UC %bb.2

  bb.1:
    successors: %bb.2
    liveins: $r1, $r2

    CMPrr $r1, $r2, implicit-def $psw, implicit-def dead $c
    JMPR_UC %bb.2

  bb.2:
    liveins: $r1, $r2
    CMPrr killed $r1, killed $r2, implicit-def dead $psw, implicit-def dead $c
    RETS

# CHECK-LABEL: name: compare_with_multiple_predecessors
# CHECK:       bb.2:
# CHECK:       CMPrr killed $r1, killed $r2
...
---
name:            compare_in_extension_window
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $r1, $r2, $r13

    EXTPr $r13, 2
    CMPrr $r1, $r2, implicit-def dead $psw, implicit-def dead $c
    JMPR_UC %bb.1

  bb.1:
    liveins: $r1, $r2
    CMPrr killed $r1, killed $r2, implicit-def dead $psw, implicit-def dead $c
    RETS

# CHECK-LABEL: name: compare_in_extension_window
# CHECK:       EXTPr $r13, 2
# CHECK-NEXT:  CMPrr $r1, $r2
# CHECK:       bb.1:
# CHECK:       CMPrr killed $r1, killed $r2
...
