# RUN: llc -mtriple=c166-none-elf -run-pass=c166-post-ra \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s

--- |
  target triple = "c166-none-elf"

  define void @fold_loaded_boolean_or() { ret void }
  define void @keep_live_or_flags() { ret void }
  define void @keep_volatile_load() { ret void }
  define void @keep_nontrivial_update_block() { ret void }
  define void @keep_boolean_load_base() { ret void }
...
---
name:            fold_loaded_boolean_or
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r3, $r4

    $r2 = MOVri4 1, implicit-def dead $psw
    $r3 = ORrr killed $r3, killed $r4, implicit-def $psw, implicit-def dead $c
    JMPR_NE %bb.2, implicit $psw

  bb.1:
    successors: %bb.2

    $r2 = MOVri4 0, implicit-def dead $psw

  bb.2:
    liveins: $r2

    $r1 = MOVrm16 $r0, 42, implicit-def dead $psw :: (load (s16))
    $r1 = ORrr killed $r1, killed $r2, implicit-def dead $psw, implicit-def dead $c
    RETS implicit $r1

# CHECK-LABEL: name: fold_loaded_boolean_or
# CHECK:       bb.0:
# CHECK:       $r2 = MOVrm16 $r0, 42
# CHECK-NEXT:  $r3 = ORrr killed $r3, killed $r4
# CHECK-NEXT:  JMPR_EQ %bb.2
# CHECK:       bb.1:
# CHECK:       liveins: $r2
# CHECK:       $r2 = BSETreg killed $r2, 0
# CHECK:       bb.2:
# CHECK:       $r1 = MOVrr killed $r2
# CHECK-NOT:   $r1 = ORrr
# CHECK-NOT:   MOVri4 1
# CHECK-NOT:   MOVri4 0
...
---
name:            keep_live_or_flags
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r3, $r4

    $r2 = MOVri4 1, implicit-def dead $psw
    $r3 = ORrr killed $r3, killed $r4, implicit-def $psw, implicit-def dead $c
    JMPR_NE %bb.2, implicit $psw

  bb.1:
    successors: %bb.2

    $r2 = MOVri4 0, implicit-def dead $psw

  bb.2:
    liveins: $r2

    $r1 = MOVrm16 $r0, 42, implicit-def dead $psw :: (load (s16))
    $r1 = ORrr killed $r1, killed $r2, implicit-def dead $psw, implicit-def $c
    RETS implicit $r1, implicit $c

# CHECK-LABEL: name: keep_live_or_flags
# CHECK:       $r2 = MOVri4 1
# CHECK:       JMPR_NE %bb.2
# CHECK:       $r2 = MOVri4 0
# CHECK:       $r1 = MOVrm16 $r0, 42
# CHECK-NEXT:  $r1 = ORrr killed $r1, killed $r2
# CHECK-NOT:   BSETreg
...
---
name:            keep_volatile_load
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r3, $r4

    $r2 = MOVri4 1, implicit-def dead $psw
    $r3 = ORrr killed $r3, killed $r4, implicit-def $psw, implicit-def dead $c
    JMPR_NE %bb.2, implicit $psw

  bb.1:
    successors: %bb.2

    $r2 = MOVri4 0, implicit-def dead $psw

  bb.2:
    liveins: $r2

    $r1 = MOVrm16 $r0, 42, implicit-def dead $psw :: (volatile load (s16))
    $r1 = ORrr killed $r1, killed $r2, implicit-def dead $psw, implicit-def dead $c
    RETS implicit $r1

# CHECK-LABEL: name: keep_volatile_load
# CHECK:       $r2 = MOVri4 1
# CHECK:       JMPR_NE %bb.2
# CHECK:       $r2 = MOVri4 0
# CHECK:       $r1 = MOVrm16 $r0, 42
# CHECK-NEXT:  $r1 = ORrr killed $r1, killed $r2
# CHECK-NOT:   BSETreg
...
---
name:            keep_nontrivial_update_block
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r3, $r4

    $r2 = MOVri4 1, implicit-def dead $psw
    $r3 = ORrr killed $r3, killed $r4, implicit-def $psw, implicit-def dead $c
    JMPR_NE %bb.2, implicit $psw

  bb.1:
    successors: %bb.2

    $r2 = MOVri4 0, implicit-def dead $psw
    dead $r6 = MOVri4 7, implicit-def dead $psw

  bb.2:
    liveins: $r2

    $r1 = MOVrm16 $r0, 42, implicit-def dead $psw :: (load (s16))
    $r1 = ORrr killed $r1, killed $r2, implicit-def dead $psw, implicit-def dead $c
    RETS implicit $r1

# CHECK-LABEL: name: keep_nontrivial_update_block
# CHECK:       $r2 = MOVri4 1
# CHECK:       JMPR_NE %bb.2
# CHECK:       $r2 = MOVri4 0
# CHECK-NEXT:  dead $r6 = MOVri4 7
# CHECK:       $r1 = MOVrm16 $r0, 42
# CHECK-NEXT:  $r1 = ORrr killed $r1, killed $r2
# CHECK-NOT:   BSETreg
...
---
name:            keep_boolean_load_base
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r3, $r4

    $r2 = MOVri4 1, implicit-def dead $psw
    $r3 = ORrr killed $r3, killed $r4, implicit-def $psw, implicit-def dead $c
    JMPR_NE %bb.2, implicit $psw

  bb.1:
    successors: %bb.2

    $r2 = MOVri4 0, implicit-def dead $psw

  bb.2:
    liveins: $r2

    $r1 = MOVrm $r2, implicit-def dead $psw :: (load (s16))
    $r1 = ORrr killed $r1, killed $r2, implicit-def dead $psw, implicit-def dead $c
    RETS implicit $r1

# CHECK-LABEL: name: keep_boolean_load_base
# CHECK:       $r2 = MOVri4 1
# CHECK:       JMPR_NE %bb.2
# CHECK:       $r2 = MOVri4 0
# CHECK:       $r1 = MOVrm $r2
# CHECK-NEXT:  $r1 = ORrr killed $r1, killed $r2
# CHECK-NOT:   BSETreg
...
