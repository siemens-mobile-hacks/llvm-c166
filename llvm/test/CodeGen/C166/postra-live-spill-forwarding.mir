# RUN: llc -mtriple=c166-none-elf -run-pass=c166-post-ra \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s

--- |
  target triple = "c166-none-elf"

  declare void @callee() addrspace(1)

  define void @forward_across_call_and_successor() #0 { ret void }
  define void @forward_to_multiple_successors() #0 { ret void }
  define void @forward_only_to_needed_successor() #0 { ret void }
  define void @forward_before_overwrite() #0 { ret void }
  define void @keep_call_clobber() #0 { ret void }
  define void @keep_path_clobber() #0 { ret void }
  define void @keep_path_overwrite() #0 { ret void }
  define void @keep_wide_spill_slot() #0 { ret void }
  define void @keep_volatile_access() #0 { ret void }
  define void @keep_without_size_attribute() { ret void }

  attributes #0 = { optsize }
...
---
name:            forward_across_call_and_successor
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body:             |
  bb.0:
    successors: %bb.1
    liveins: $r0, $r9

    MOVmr16 $r0, 20, $r9, implicit-def dead $psw :: (store (s16) into %stack.0)
    $r13 = MOVrr killed $r9, implicit-def dead $psw
    CALLS @callee, @callee, csr_c166_callpreserved, implicit killed $r13
    JMPR_UC %bb.1

  bb.1:
    $r4 = MOVrm16 $r0, 20, implicit-def dead $psw :: (load (s16) from %stack.0)
    RETS implicit $r4

# CHECK-LABEL: name: forward_across_call_and_successor
# CHECK-NOT:   MOVmr16
# CHECK:       $r13 = MOVrr $r9
# CHECK:       CALLS @callee, @callee, csr_c166_callpreserved, implicit killed $r13
# CHECK:       bb.1:
# CHECK:       liveins: $r9
# CHECK:       $r4 = MOVrr $r9, implicit-def dead $psw
# CHECK-NOT:   MOVrm16
...
---
name:            forward_to_multiple_successors
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r0, $r6, $r9

    MOVmr16 $r0, 20, $r9, implicit-def dead $psw :: (store (s16) into %stack.0)
    CALLS @callee, @callee, csr_c166_callpreserved
    CMPri3 killed $r6, 0, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    $r4 = MOVrm16 $r0, 20, implicit-def dead $psw :: (load (s16) from %stack.0)
    RETS implicit $r4

  bb.2:
    $r5 = MOVrm16 $r0, 20, implicit-def dead $psw :: (load (s16) from %stack.0)
    RETS implicit $r5

# CHECK-LABEL: name: forward_to_multiple_successors
# CHECK-NOT:   MOVmr16
# CHECK:       bb.1:
# CHECK:       liveins: $r9
# CHECK:       $r4 = MOVrr $r9, implicit-def dead $psw
# CHECK:       bb.2:
# CHECK:       liveins: $r9
# CHECK:       $r5 = MOVrr $r9, implicit-def dead $psw
# CHECK-NOT:   MOVrm16
...
---
name:            forward_only_to_needed_successor
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r0, $r6, $r9

    MOVmr16 $r0, 20, $r9, implicit-def dead $psw :: (store (s16) into %stack.0)
    CALLS @callee, @callee, csr_c166_callpreserved
    CMPri3 killed $r6, 0, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    $r4 = MOVrm16 $r0, 20, implicit-def dead $psw :: (load (s16) from %stack.0)
    RETS implicit $r4

  bb.2:
    RETS

# CHECK-LABEL: name: forward_only_to_needed_successor
# CHECK-NOT:   MOVmr16
# CHECK:       bb.1:
# CHECK:       liveins: $r9
# CHECK:       $r4 = MOVrr $r9, implicit-def dead $psw
# CHECK:       bb.2:
# CHECK-NEXT:  RETS
# CHECK-NOT:   MOVrm16
...
---
name:            forward_before_overwrite
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body:             |
  bb.0:
    liveins: $r0, $r8, $r9

    MOVmr16 $r0, 20, $r9, implicit-def dead $psw :: (store (s16) into %stack.0)
    $r4 = MOVrm16 $r0, 20, implicit-def dead $psw :: (load (s16) from %stack.0)
    MOVmr16 $r0, 20, $r8, implicit-def dead $psw :: (store (s16) into %stack.0)
    $r5 = MOVrm16 $r0, 20, implicit-def dead $psw :: (load (s16) from %stack.0)
    RETS implicit $r4, implicit $r5

# CHECK-LABEL: name: forward_before_overwrite
# CHECK-NOT:   MOVmr16
# CHECK:       $r4 = MOVrr $r9, implicit-def dead $psw
# CHECK-NEXT:  $r5 = MOVrr $r8, implicit-def dead $psw
# CHECK-NOT:   MOVrm16
...
---
name:            keep_call_clobber
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body:             |
  bb.0:
    liveins: $r0, $r9

    MOVmr16 $r0, 20, killed $r9, implicit-def dead $psw :: (store (s16) into %stack.0)
    CALLS @callee, @callee, csr_c166_callpreserved, implicit-def $r9
    $r4 = MOVrm16 $r0, 20, implicit-def dead $psw :: (load (s16) from %stack.0)
    RETS implicit $r4

# CHECK-LABEL: name: keep_call_clobber
# CHECK:       MOVmr16 $r0, 20, killed $r9
# CHECK:       CALLS @callee, @callee, csr_c166_callpreserved, implicit-def $r9
# CHECK:       $r4 = MOVrm16 $r0, 20
...
---
name:            keep_path_clobber
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r0, $r1, $r9

    MOVmr16 $r0, 20, $r9, implicit-def dead $psw :: (store (s16) into %stack.0)
    CMPri3 killed $r1, 0, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    successors: %bb.3

    $r9 = MOVri4 1, implicit-def dead $psw
    JMPR_UC %bb.3

  bb.2:
    successors: %bb.3

    JMPR_UC %bb.3

  bb.3:
    $r4 = MOVrm16 $r0, 20, implicit-def dead $psw :: (load (s16) from %stack.0)
    RETS implicit $r4

# CHECK-LABEL: name: keep_path_clobber
# CHECK:       MOVmr16 $r0, 20, $r9
# CHECK:       $r9 = MOVri4 1
# CHECK:       $r4 = MOVrm16 $r0, 20
...
---
name:            keep_path_overwrite
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r0, $r1, $r8, $r9

    MOVmr16 $r0, 20, $r9, implicit-def dead $psw :: (store (s16) into %stack.0)
    CMPri3 killed $r1, 0, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    successors: %bb.3
    liveins: $r8

    MOVmr16 $r0, 20, $r8, implicit-def dead $psw :: (store (s16) into %stack.0)
    JMPR_UC %bb.3

  bb.2:
    successors: %bb.3

    JMPR_UC %bb.3

  bb.3:
    $r4 = MOVrm16 $r0, 20, implicit-def dead $psw :: (load (s16) from %stack.0)
    RETS implicit $r4

# CHECK-LABEL: name: keep_path_overwrite
# CHECK:       MOVmr16 $r0, 20, $r9
# CHECK:       MOVmr16 $r0, 20, $r8
# CHECK:       $r4 = MOVrm16 $r0, 20
...
---
name:            keep_wide_spill_slot
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 2 }
body:             |
  bb.0:
    liveins: $r0, $r9

    MOVmr16 $r0, 20, $r9, implicit-def dead $psw :: (store (s16) into %stack.0)
    CALLS @callee, @callee, csr_c166_callpreserved
    $r4 = MOVrm16 $r0, 20, implicit-def dead $psw :: (load (s16) from %stack.0)
    RETS implicit $r4

# CHECK-LABEL: name: keep_wide_spill_slot
# CHECK:       MOVmr16 $r0, 20, $r9
# CHECK:       CALLS @callee, @callee, csr_c166_callpreserved
# CHECK-NEXT:  $r4 = MOVrm16 $r0, 20
...
---
name:            keep_volatile_access
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body:             |
  bb.0:
    liveins: $r0, $r9

    MOVmr16 $r0, 20, killed $r9, implicit-def dead $psw :: (volatile store (s16) into %stack.0)
    $r4 = MOVrm16 $r0, 20, implicit-def dead $psw :: (volatile load (s16) from %stack.0)
    RETS implicit $r4

# CHECK-LABEL: name: keep_volatile_access
# CHECK:       MOVmr16 $r0, 20, killed $r9
# CHECK-NEXT:  $r4 = MOVrm16 $r0, 20
...
---
name:            keep_without_size_attribute
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body:             |
  bb.0:
    liveins: $r0, $r9

    MOVmr16 $r0, 20, $r9, implicit-def dead $psw :: (store (s16) into %stack.0)
    CALLS @callee, @callee, csr_c166_callpreserved
    $r4 = MOVrm16 $r0, 20, implicit-def dead $psw :: (load (s16) from %stack.0)
    RETS implicit $r4

# CHECK-LABEL: name: keep_without_size_attribute
# CHECK:       MOVmr16 $r0, 20, $r9
# CHECK:       CALLS @callee, @callee, csr_c166_callpreserved
# CHECK-NEXT:  $r4 = MOVrm16 $r0, 20
...
