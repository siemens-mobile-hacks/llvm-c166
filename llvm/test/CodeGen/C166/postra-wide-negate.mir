# RUN: llc -mtriple=c166-none-elf -run-pass=c166-post-ra \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s

--- |
  target triple = "c166-none-elf"

  define void @fold_wide_negate() { ret void }
  define void @keep_live_flags() { ret void }
  define void @keep_live_boolean() { ret void }
  define void @keep_nontrivial_clear_block() { ret void }
...
---
name:            fold_wide_negate
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r13r12

    $r1 = MOVri4 1, implicit-def dead $psw
    CMPri3 $r12, 0, implicit-def $psw, implicit-def $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    successors: %bb.2

    $r1 = MOVri4 0, implicit-def dead $psw

  bb.2:
    liveins: $r1, $r13r12

    $r13 = CPL $r13, implicit-def dead $psw, implicit-def dead $c, implicit killed $r13r12, implicit-def $r13r12
    $r13 = nuw nsw ADDrr $r13, killed $r1, implicit-def dead $psw, implicit-def dead $c, implicit killed $r13r12, implicit-def $r13r12
    $r12 = NEG $r12, implicit-def dead $psw, implicit-def dead $c, implicit killed $r13r12, implicit-def $r13r12
    RETS implicit $r13r12

# CHECK-LABEL: name: fold_wide_negate
# CHECK-NOT:   MOVri4 1
# CHECK-NOT:   MOVri4 0
# CHECK-NOT:   CMPri3
# CHECK-NOT:   JMPR_EQ
# CHECK:       $r13 = CPL $r13
# CHECK-NEXT:  $r12 = NEG $r12, implicit-def dead $psw, implicit-def $c
# CHECK-NEXT:  $r13 = SUBCri16 killed $r13, 65535
# CHECK-NOT:   nuw
# CHECK-NOT:   nsw
# CHECK-NEXT:  RETS implicit $r13r12
...
---
name:            keep_live_flags
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r13r12

    $r1 = MOVri4 1, implicit-def dead $psw
    CMPri3 $r12, 0, implicit-def $psw, implicit-def $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    successors: %bb.2

    $r1 = MOVri4 0, implicit-def dead $psw

  bb.2:
    liveins: $r1, $r13r12

    $r13 = CPL $r13, implicit-def dead $psw, implicit-def dead $c, implicit killed $r13r12, implicit-def $r13r12
    $r13 = ADDrr $r13, killed $r1, implicit-def dead $psw, implicit-def dead $c, implicit killed $r13r12, implicit-def $r13r12
    $r12 = NEG $r12, implicit-def $psw, implicit-def $c, implicit killed $r13r12, implicit-def $r13r12
    RETS implicit $r13r12, implicit $psw, implicit $c

# CHECK-LABEL: name: keep_live_flags
# CHECK:       $r1 = MOVri4 1
# CHECK:       CMPri3 $r12, 0
# CHECK:       JMPR_EQ %bb.2
# CHECK:       $r1 = MOVri4 0
# CHECK:       $r13 = ADDrr $r13, killed $r1
# CHECK-NOT:   SUBCri16
...
---
name:            keep_live_boolean
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r13r12

    $r1 = MOVri4 1, implicit-def dead $psw
    CMPri3 $r12, 0, implicit-def $psw, implicit-def $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    successors: %bb.2

    $r1 = MOVri4 0, implicit-def dead $psw

  bb.2:
    liveins: $r1, $r13r12

    $r13 = CPL $r13, implicit-def dead $psw, implicit-def dead $c, implicit killed $r13r12, implicit-def $r13r12
    $r13 = ADDrr $r13, $r1, implicit-def dead $psw, implicit-def dead $c, implicit killed $r13r12, implicit-def $r13r12
    $r12 = NEG $r12, implicit-def dead $psw, implicit-def dead $c, implicit killed $r13r12, implicit-def $r13r12
    RETS implicit $r13r12, implicit $r1

# CHECK-LABEL: name: keep_live_boolean
# CHECK:       $r1 = MOVri4 1
# CHECK:       JMPR_EQ %bb.2
# CHECK:       $r1 = MOVri4 0
# CHECK:       $r13 = ADDrr $r13, $r1
# CHECK-NOT:   SUBCri16
...
---
name:            keep_nontrivial_clear_block
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r13r12

    $r1 = MOVri4 1, implicit-def dead $psw
    CMPri3 $r12, 0, implicit-def $psw, implicit-def $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    successors: %bb.2

    $r1 = MOVri4 0, implicit-def dead $psw
    dead $r4 = MOVri4 7, implicit-def dead $psw

  bb.2:
    liveins: $r1, $r13r12

    $r13 = CPL $r13, implicit-def dead $psw, implicit-def dead $c, implicit killed $r13r12, implicit-def $r13r12
    $r13 = ADDrr $r13, killed $r1, implicit-def dead $psw, implicit-def dead $c, implicit killed $r13r12, implicit-def $r13r12
    $r12 = NEG $r12, implicit-def dead $psw, implicit-def dead $c, implicit killed $r13r12, implicit-def $r13r12
    RETS implicit $r13r12

# CHECK-LABEL: name: keep_nontrivial_clear_block
# CHECK:       $r1 = MOVri4 1
# CHECK:       JMPR_EQ %bb.2
# CHECK:       $r1 = MOVri4 0
# CHECK-NEXT:  dead $r4 = MOVri4 7
# CHECK:       $r13 = ADDrr $r13, killed $r1
# CHECK-NOT:   SUBCri16
...
