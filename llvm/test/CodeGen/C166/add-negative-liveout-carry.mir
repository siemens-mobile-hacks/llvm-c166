# RUN: llc -mtriple=c166-none-elf -run-pass=c166-post-ra -verify-machineinstrs -o - %s | FileCheck %s

# CHECK: ADDri16 $r4, 65535
# CHECK: ADDCri3

--- |
  define void @add_negative_liveout_carry() { ret void }
...
---
name: add_negative_liveout_carry
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r4
    $r4 = ADDri16 $r4, 65535, implicit-def dead $psw, implicit-def $c
  bb.1:
    liveins: $c, $r4
    $r5 = MOVri4 0, implicit-def $psw
    $r5 = ADDCri3 $r5, 0, implicit-def dead $psw, implicit-def dead $c, implicit $psw, implicit $c
    RETS implicit $r4, implicit $r5
...
