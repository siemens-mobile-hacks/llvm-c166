# RUN: llc -mtriple=c166-none-elf -run-pass=c166-post-ra \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s

--- |
  target triple = "c166-none-elf"

  define void @fold_xor_bit_set() { ret void }
  define void @fold_xor_bit_clear() { ret void }
  define void @fold_signed_sign_difference() { ret void }
  define void @keep_live_xor_flags() { ret void }
  define void @keep_live_xor_value() { ret void }
...
---
name:            fold_xor_bit_set
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r2, $r3

    $r1 = MOVrr killed $r3, implicit-def dead $psw
    $r1 = XORrr killed $r1, killed $r2, implicit-def dead $psw, implicit-def dead $c
    JBreg killed $r1, 15, %bb.2

  bb.1:
    RETS

  bb.2:
    RETS

# CHECK-LABEL: name: fold_xor_bit_set
# CHECK:       BCMPreg killed $r3, killed $r2, 15, 15
# CHECK-NEXT:  JMPR_N %bb.2
# CHECK-NOT:   XORrr
# CHECK-NOT:   JBreg
...
---
name:            fold_xor_bit_clear
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r4, $r5

    $r1 = MOVrr killed $r4, implicit-def dead $psw
    $r1 = XORrr killed $r1, killed $r5, implicit-def dead $psw, implicit-def dead $c
    JNBreg killed $r1, 7, %bb.2

  bb.1:
    RETS

  bb.2:
    RETS

# CHECK-LABEL: name: fold_xor_bit_clear
# CHECK:       BCMPreg killed $r4, killed $r5, 7, 7
# CHECK-NEXT:  JMPR_NN %bb.2
# CHECK-NOT:   XORrr
# CHECK-NOT:   JNBreg
...
---
name:            fold_signed_sign_difference
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r2, $r3

    $r1 = MOVrr killed $r3, implicit-def dead $psw
    $r1 = XORrr killed $r1, killed $r2, implicit-def dead $psw, implicit-def dead $c
    CMPri16 killed $r1, -1, implicit-def $psw, implicit-def dead $c
    JMPR_SLE %bb.2, implicit $psw

  bb.1:
    RETS

  bb.2:
    RETS

# CHECK-LABEL: name: fold_signed_sign_difference
# CHECK:       BCMPreg killed $r3, killed $r2, 15, 15
# CHECK-NEXT:  JMPR_N %bb.2
# CHECK-NOT:   XORrr
# CHECK-NOT:   CMPri16
...
---
name:            keep_live_xor_flags
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r2, $r3

    $r1 = MOVrr killed $r3, implicit-def dead $psw
    $r1 = XORrr killed $r1, killed $r2, implicit-def dead $psw, implicit-def $c
    JBreg killed $r1, 15, %bb.2

  bb.1:
    liveins: $c
    RETS implicit $c

  bb.2:
    liveins: $c
    RETS implicit $c

# CHECK-LABEL: name: keep_live_xor_flags
# CHECK:       $r1 = MOVrr killed $r3
# CHECK-NEXT:  $r1 = XORrr killed $r1, killed $r2
# CHECK-NEXT:  JBreg killed $r1, 15, %bb.2
...
---
name:            keep_live_xor_value
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r2, $r3

    $r1 = MOVrr killed $r3, implicit-def dead $psw
    $r1 = XORrr killed $r1, killed $r2, implicit-def dead $psw, implicit-def dead $c
    JBreg $r1, 15, %bb.2

  bb.1:
    liveins: $r1
    RETS implicit $r1

  bb.2:
    liveins: $r1
    RETS implicit $r1

# CHECK-LABEL: name: keep_live_xor_value
# CHECK:       $r1 = MOVrr killed $r3
# CHECK-NEXT:  $r1 = XORrr killed $r1, killed $r2
# CHECK-NEXT:  JBreg $r1, 15, %bb.2
...
