# RUN: llc -mtriple=c166-none-elf -run-pass=c166-post-isel \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s

--- |
  target triple = "c166-none-elf"

  define void @rematerialize_add_carry_branch() { ret void }
  define void @keep_adjacent_add_carry_branch() { ret void }
  define void @lower_virtual_setcarry() { ret void }
  define void @preserve_virtual_setcarry_source() { ret void }
  define void @keep_multiply_used_carry() { ret void }
...
---
name:            rematerialize_add_carry_branch
tracksRegLiveness: true
registers:
  - { id: 0, class: gr16 }
  - { id: 1, class: gr16 }
  - { id: 2, class: carry }
  - { id: 3, class: gr16 }
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r12, $r13

    %0:gr16 = COPY $r12
    %1:gr16, %2:carry = ADDCarryri3 %0, 3, implicit-def dead $psw
    %3:gr16 = ORrr %1, $r13, implicit-def dead $psw, implicit-def dead $c
    FLAGSBR killed %2, 4, %bb.2, implicit $psw
    BR %bb.1

  bb.1:
    $r4 = COPY %3
    RETS implicit $r4

  bb.2:
    $r4 = COPY %3
    RETS implicit $r4

# CHECK-LABEL: name: rematerialize_add_carry_branch
# CHECK:       %1:gr16, dead %2:carry = ADDCarryri3 %0, 3
# CHECK:       %3:gr16 = ORrr %1, $r13
# CHECK-NEXT:  CMPBRi %1, 3, 4, %bb.2
# CHECK-NEXT:  BR %bb.1
# CHECK-NOT:   FLAGSBR
...
---
name:            keep_adjacent_add_carry_branch
tracksRegLiveness: true
registers:
  - { id: 0, class: gr16 }
  - { id: 1, class: gr16 }
  - { id: 2, class: carry }
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r12

    %0:gr16 = COPY $r12
    %1:gr16, %2:carry = ADDCarryri3 %0, 1, implicit-def dead $psw
    FLAGSBR killed %2, 4, %bb.2, implicit $psw
    BR %bb.1

  bb.1:
    $r4 = COPY %1
    RETS implicit $r4

  bb.2:
    $r4 = COPY %1
    RETS implicit $r4

# CHECK-LABEL: name: keep_adjacent_add_carry_branch
# CHECK:       %1:gr16, %2:carry = ADDCarryri3 %0, 1
# CHECK-NEXT:  FLAGSBR killed %2, 4, %bb.2
# CHECK-NOT:   CMPBRi
...
---
name:            lower_virtual_setcarry
tracksRegLiveness: true
registers:
  - { id: 0, class: gr16 }
  - { id: 1, class: gr16 }
  - { id: 2, class: gr16 }
  - { id: 3, class: carry }
  - { id: 4, class: gr16 }
  - { id: 5, class: gr16 }
body:             |
  bb.0:
    liveins: $r12, $r13, $r14

    %0:gr16 = COPY $r12
    %1:gr16 = COPY $r13
    %2:gr16 = COPY $r14
    %3:carry = SETCARRY killed %2, implicit-def dead $psw
    %4:gr16 = ORrr %0, %1, implicit-def dead $psw, implicit-def dead $c
    %5:gr16, %0:gr16 = SUBCCarryValuerr %4, %1, killed %3, implicit-def dead $psw, implicit-def dead $c, implicit $psw
    $r4 = COPY %5
    RETS implicit $r4

# CHECK-LABEL: name: lower_virtual_setcarry
# CHECK-NOT:   SETCARRY
# CHECK:       %4:gr16 = ORrr %0, %1
# CHECK-NEXT:  dead %6:gr16 = SHRri4 killed %2, 1, implicit-def dead $psw, implicit-def $c
# CHECK-NEXT:  %5:gr16, %0:gr16 = SUBCCarryValuerr %4, %1, killed $c
...
---
name:            preserve_virtual_setcarry_source
tracksRegLiveness: true
registers:
  - { id: 0, class: gr16 }
  - { id: 1, class: gr16 }
  - { id: 2, class: gr16 }
  - { id: 3, class: carry }
  - { id: 4, class: gr16 }
  - { id: 5, class: gr16 }
  - { id: 6, class: gr16 }
body:             |
  bb.0:
    liveins: $r12, $r13, $r14

    %0:gr16 = COPY $r12
    %1:gr16 = COPY $r13
    %2:gr16 = COPY $r14
    %3:carry = SETCARRY %2, implicit-def dead $psw
    %4:gr16 = ORrr %0, %1, implicit-def dead $psw, implicit-def dead $c
    %5:gr16, %0:gr16 = SUBCCarryValuerr %4, %1, killed %3, implicit-def dead $psw, implicit-def dead $c, implicit $psw
    %6:gr16 = ADDrr %5, %2, implicit-def dead $psw, implicit-def dead $c
    $r4 = COPY %6
    RETS implicit $r4

# CHECK-LABEL: name: preserve_virtual_setcarry_source
# CHECK-NOT:   SETCARRY
# CHECK:       %4:gr16 = ORrr %0, %1
# CHECK-NEXT:  %7:gr16 = COPY %2
# CHECK-NEXT:  dead %8:gr16 = SHRri4 killed %7, 1, implicit-def dead $psw, implicit-def $c
# CHECK-NEXT:  %5:gr16, %0:gr16 = SUBCCarryValuerr %4, %1, killed $c
# CHECK-NEXT:  %6:gr16 = ADDrr %5, %2
...
---
name:            keep_multiply_used_carry
tracksRegLiveness: true
registers:
  - { id: 0, class: gr16 }
  - { id: 1, class: gr16 }
  - { id: 2, class: carry }
  - { id: 3, class: gr16 }
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r12, $r13

    %0:gr16 = COPY $r12
    %1:gr16, %2:carry = ADDCarryri3 %0, 1, implicit-def dead $psw
    %3:gr16 = ADDCCarryInrr %1, $r13, %2, implicit-def dead $psw, implicit-def dead $c, implicit $psw
    FLAGSBR killed %2, 2, %bb.2, implicit $psw
    BR %bb.1

  bb.1:
    $r4 = COPY %3
    RETS implicit $r4

  bb.2:
    $r4 = COPY %3
    RETS implicit $r4

# CHECK-LABEL: name: keep_multiply_used_carry
# CHECK:       %1:gr16, %2:carry = ADDCarryri3 %0, 1
# CHECK:       %3:gr16 = ADDCCarryInrr %1, $r13, %2
# CHECK-NEXT:  FLAGSBR killed %2, 2, %bb.2
# CHECK-NOT:   CMPBRi
...
