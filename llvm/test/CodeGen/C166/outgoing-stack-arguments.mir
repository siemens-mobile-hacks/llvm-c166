# RUN: llc -mtriple=c166-none-elf \
# RUN:   -run-pass=c166-call-frame-expansion -verify-machineinstrs \
# RUN:   -o - %s | FileCheck %s

--- |
  target triple = "c166-none-elf"

  define void @expand_call_frame() { ret void }
...
---
name:            expand_call_frame
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r12, $r13

    ALLOCSP 8, 8, implicit-def dead $r0, implicit-def dead $psw, implicit $r0
    PUSHARG 10, $r13, implicit-def dead $r0, implicit-def dead $psw, implicit $r0
    PUSHARG 12, killed $r12, implicit-def dead $r0, implicit-def dead $psw, implicit $r0
    RETS

# CHECK-LABEL: name: expand_call_frame
# CHECK-NOT:   ALLOCSP
# CHECK-NOT:   PUSHARG
# CHECK:       $r0 = SUBri16 $r0, 8
# CHECK:       $r0 = MOVmrPreDec $r0, $r13
# CHECK:       $r0 = MOVmrPreDec $r0, killed $r12
...
