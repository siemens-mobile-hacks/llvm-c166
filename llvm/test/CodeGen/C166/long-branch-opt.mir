# RUN: llc -mtriple=c166-none-elf -run-pass=c166-long-branch-opt \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s

--- |
  target triple = "c166-none-elf"

  define void @fold_eq() { ret void }
  define void @fold_ult() { ret void }
  define void @keep_bit_branch() { ret void }
  define void @keep_cross_section() { ret void }
...
---
name:            fold_eq
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $psw

    JMPR_NE %bb.2, implicit $psw

  bb.1:
    successors: %bb.3

    JMPS %bb.3, %bb.3

  bb.2:
    RETS

  bb.3:
    RETS

# CHECK-LABEL: name: fold_eq
# CHECK:       bb.0:
# CHECK-NEXT:    successors: %bb.3({{.*}}), %bb.2({{.*}})
# CHECK:         JMPA_EQ %bb.3, implicit $psw
# CHECK:       bb.2:
# CHECK-NOT:     JMPS
...
---
name:            fold_ult
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $psw, $c

    JMPR_UGE %bb.2, implicit $psw, implicit $c

  bb.1:
    successors: %bb.3

    JMPS %bb.3, %bb.3

  bb.2:
    RETS

  bb.3:
    RETS

# CHECK-LABEL: name: fold_ult
# CHECK:       JMPA_ULT %bb.3, implicit $psw, implicit $c
# CHECK-NOT:   JMPS
...
---
name:            keep_bit_branch
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r2

    JNBreg $r2, 15, %bb.2

  bb.1:
    successors: %bb.3

    JMPS %bb.3, %bb.3

  bb.2:
    RETS

  bb.3:
    RETS

# CHECK-LABEL: name: keep_bit_branch
# CHECK:       JNBreg $r2, 15, %bb.2
# CHECK:       JMPS %bb.3, %bb.3
...
---
name:            keep_cross_section
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $psw

    JMPR_NE %bb.2, implicit $psw

  bb.1:
    successors: %bb.3

    JMPS %bb.3, %bb.3

  bb.2:
    RETS

  bb.3 (bbsections Cold):
    RETS

# CHECK-LABEL: name: keep_cross_section
# CHECK:       JMPR_NE %bb.2, implicit $psw
# CHECK:       JMPS %bb.3, %bb.3
...
