# RUN: llc -mtriple=c166-none-elf -run-pass=c166-post-ra -verify-machineinstrs -o - %s | FileCheck %s

# CHECK: MOVmr16 $r0, 8, $r9
# CHECK: CALLS
# CHECK: $r14 = MOVrr $r9
# CHECK: CALLS
# CHECK: $r4 = MOVrm16 $r0, 8

--- |
  declare void @callee() addrspace(1)
  define void @spill_partial_forward() nounwind optsize { ret void }
...
---
name: spill_partial_forward
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0:
    liveins: $r0, $r9
    MOVmr16 $r0, 8, $r9, implicit-def dead $psw :: (store (s16) into %stack.0)
    CALLS @callee, @callee, csr_c166_callpreserved
    $r14 = MOVrm16 $r0, 8, implicit-def dead $psw :: (load (s16) from %stack.0)
    CALLS @callee, @callee, csr_c166_callpreserved, implicit $r14, implicit-def $r9
    $r4 = MOVrm16 $r0, 8, implicit-def dead $psw :: (load (s16) from %stack.0)
    RETS implicit $r4
...
