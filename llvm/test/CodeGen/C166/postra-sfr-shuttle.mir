# RUN: llc -mtriple=c166-none-elf -run-pass=c166-post-ra \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s

--- |
  target triple = "c166-none-elf"

  define void @fold_sfr_shuttle() { ret void }
  define void @keep_reused_temporary() { ret void }
  define void @keep_clobbered_source() { ret void }
...
---
name:            fold_sfr_shuttle
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r2, $mdh

    $r1 = MOVgsfr $mdh, implicit-def dead $psw
    $r2 = ORri3 killed $r2, 1, implicit-def dead $psw, implicit-def dead $c
    $mdl = MOVsfrg $r1, implicit-def dead $psw
    RETS

# CHECK-LABEL: name: fold_sfr_shuttle
# CHECK-NOT:   MOVgsfr
# CHECK:       $r2 = ORri3
# CHECK-NEXT:  $mdl = MOVsfrsfr $mdh, implicit-def dead $psw
# CHECK-NEXT:  RETS
...
---
name:            keep_reused_temporary
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $mdh

    $r1 = MOVgsfr $mdh, implicit-def dead $psw
    $mdl = MOVsfrg $r1, implicit-def dead $psw
    $r2 = MOVrr $r1, implicit-def dead $psw
    RETS implicit $r2

# CHECK-LABEL: name: keep_reused_temporary
# CHECK:       $r1 = MOVgsfr $mdh
# CHECK-NEXT:  $mdl = MOVsfrg $r1
...
---
name:            keep_clobbered_source
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r2, $mdh

    $r1 = MOVgsfr $mdh, implicit-def dead $psw
    $mdh = MOVsfrg $r2, implicit-def dead $psw
    $mdl = MOVsfrg $r1, implicit-def dead $psw
    RETS

# CHECK-LABEL: name: keep_clobbered_source
# CHECK:       $r1 = MOVgsfr $mdh
# CHECK-NEXT:  $mdh = MOVsfrg $r2
# CHECK-NEXT:  $mdl = MOVsfrg $r1
...
