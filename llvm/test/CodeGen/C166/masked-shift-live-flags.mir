# RUN: llc -mtriple=c166-none-elf -run-pass=c166-post-ra -verify-machineinstrs -o - %s | FileCheck %s

# CHECK: ANDri3
# CHECK: SHRri4
# CHECK: JMPR_EQ

--- |
  define void @masked_shift_flags() { ret void }
...
---
name: masked_shift_flags
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r4
    $r4 = ANDri3 $r4, 1, implicit-def dead $psw, implicit-def dead $c
    dead $r4 = SHRri4 $r4, 1, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.2, implicit $psw
  bb.1:
    $r4 = MOVri4 1, implicit-def dead $psw
    RETS implicit $r4
  bb.2:
    $r4 = MOVri4 2, implicit-def dead $psw
    RETS implicit $r4
...
