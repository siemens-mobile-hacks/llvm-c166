    $r6 = MOVrm16 $r0, 2, implicit-def dead $psw :: (load (s16))
    $r7 = ADDrr killed $r7, killed $r1, implicit-def dead $psw, implicit-def dead $c, implicit $r7r6, implicit-def $r7r6
    $r6 = MOVrr killed $r3, implicit-def dead $psw
    RETS implicit $r6

# CHECK-LABEL: name: remove_dead_low_half_load_through_high_half_update
