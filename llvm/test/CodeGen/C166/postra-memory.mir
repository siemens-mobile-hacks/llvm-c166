---
name:            keep_physical_load_live_in_successor
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r2, $r3, $r4

    $r1 = MOVrm16 $r2, 2, implicit-def $psw :: (load (s16))
    CMPrr killed $r3, killed $r4, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    liveins: $r1
    RETS implicit $r1

  bb.2:
    liveins: $r1
    RETS implicit $r1

