# RUN: llc -mtriple=c166-none-elf -run-pass=c166-post-ra \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s

--- |
  target triple = "c166-none-elf"

  define void @dead_base_load_chain() { ret void }
  define void @unannotated_load_chain() { ret void }
  define void @stack_pointer_load_chain() { ret void }
  define void @three_store_chain() { ret void }
  define void @live_base_high_store_chain() { ret void }
  define void @four_store_chain() { ret void }
  define void @permuted_store_chain() { ret void }
  define void @store_chain_hoists_copy() { ret void }
  define void @store_chain_keeps_overlapping_copy() { ret void }
  define void @store_chain_keeps_base_copy() { ret void }
  define void @store_chain_keeps_trailing_copy() { ret void }
  define void @permuted_store_chain_live_flags() { ret void }
  define void @gapped_store_chain() { ret void }
  define void @carry_live_store_chain() { ret void }
  define void @extended_store_chain() { ret void }
  define void @base_source_store_chain() { ret void }
  define void @volatile_store_chain() { ret void }
  define void @stack_pointer_store_chain() { ret void }
  define void @frame_setup_store_chain() nounwind { ret void }
  define void @frame_setup_store_chain_live_carry() nounwind { ret void }
  define void @frame_setup_store_chain_with_cfi() nounwind uwtable { ret void }
  define void @frame_setup_store_chain_no_saving() nounwind { ret void }
  define void @stack_pointer_high_offset_store_chain() { ret void }
  define void @stack_pointer_high_offset_no_scratch() { ret void }
  define void @base_overwritten_by_last_load() { ret void }
  define void @live_base_load_chain() { ret void }
  define void @spaced_live_base_load_chain() { ret void }
  define void @spaced_load_chain_live_carry() { ret void }
  define void @spaced_load_chain_no_scratch() { ret void }
  define void @split_word_load_chain() { ret void }
  define void @split_word_load_chain_live_flags() { ret void }
  define void @split_word_load_chain_early_use() { ret void }
  define void @split_word_load_chain_store_barrier() { ret void }
  define void @late_scratch_load_cluster() { ret void }
  define void @late_scratch_load_store_barrier() { ret void }
  define void @base_overwritten_before_last_load() { ret void }
  define void @fold_physical_compare_load() { ret void }
  define void @fold_spaced_postincrement_load() { ret void }
  define void @keep_multiuse_alu_load() { ret void }
  define void @keep_postincrement_base_use() { ret void }
  define void @keep_volatile_alu_load() { ret void }
  define void @keep_extended_alu_load() { ret void }
  define void @keep_left_alu_load() { ret void }
  define void @keep_live_flags_alu_load() { ret void }
  define void @keep_alu_load_across_store() { ret void }
  define void @remove_dead_physical_load() { ret void }
  define void @remove_dead_physical_load_at_branch() { ret void }
  define void @remove_dead_high_half_load_through_low_half_update() { ret void }
  define void @remove_dead_high_half_load_across_successor() { ret void }
  define void @remove_dead_low_half_load_through_high_half_update() { ret void }
  define void @keep_high_half_load_used_after_low_half_update() { ret void }
  define void @keep_high_half_load_used_in_successor() { ret void }
  define void @keep_physical_load_live_in_successor() { ret void }
  define void @keep_dead_physical_load_debug_use() { ret void }
  define void @keep_dead_physical_load_successor_debug_use() { ret void }
  define void @keep_dead_physical_load_live_flags() { ret void }
  define void @keep_volatile_dead_physical_load() { ret void }
  define void @keep_extended_dead_physical_load() { ret void }
  define void @volatile_load_chain() { ret void }
...
---
name:            dead_base_load_chain
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r7

    $r1 = MOVrm $r7, implicit-def dead $psw :: (load (s16))
    $r2 = MOVrm16 $r7, 2, implicit-def dead $psw :: (load (s16))
    $r3 = MOVrm16 $r7, 4, implicit-def dead $psw :: (load (s16))
    $r4 = MOVrm16 $r7, 6, implicit-def $psw :: (load (s16))
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    liveins: $r1, $r2, $r3, $r4
    RETS implicit $r1, implicit $r2, implicit $r3, implicit $r4

  bb.2:
    liveins: $r1, $r2, $r3, $r4
    RETS implicit $r1, implicit $r2, implicit $r3, implicit $r4

# CHECK-LABEL: name: dead_base_load_chain
# CHECK:       $r1, $r7 = MOVrmPostInc killed $r7, implicit-def dead $psw
# CHECK-NEXT:  $r2, $r7 = MOVrmPostInc killed $r7, implicit-def dead $psw
# CHECK-NEXT:  $r3, $r7 = MOVrmPostInc killed $r7, implicit-def dead $psw
# CHECK-NEXT:  $r4 = MOVrm killed $r7, implicit-def $psw
# CHECK-NEXT:  JMPR_EQ %bb.2, implicit $psw
...
---
name:            unannotated_load_chain
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r7

    $r1 = MOVrm $r7, implicit-def dead $psw
    $r2 = MOVrm16 $r7, 2, implicit-def dead $psw
    $r3 = MOVrm16 $r7, 4, implicit-def dead $psw
    RETS implicit $r1, implicit $r2, implicit $r3

# CHECK-LABEL: name: unannotated_load_chain
# CHECK:       $r1, $r7 = MOVrmPostInc killed $r7
# CHECK-NEXT:  $r2, $r7 = MOVrmPostInc killed $r7
# CHECK-NEXT:  $r3 = MOVrm killed $r7
...
---
name:            stack_pointer_load_chain
tracksRegLiveness: true
body:             |
  bb.0:
    $r1 = MOVrm $r0, implicit-def dead $psw :: (load (s16))
    $r2 = MOVrm16 $r0, 2, implicit-def dead $psw :: (load (s16))
    RETS implicit $r1, implicit $r2

# CHECK-LABEL: name: stack_pointer_load_chain
# CHECK:       $r1 = MOVrm $r0
# CHECK-NEXT:  $r2 = MOVrm16 $r0, 2
...
---
name:            three_store_chain
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r7

    MOVmr16 $r7, 4, $r1, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 2, $r2, implicit-def dead $psw :: (store (s16))
    MOVmr $r7, $r3, implicit-def dead $psw :: (store (s16))
    RETS implicit $r7

# CHECK-LABEL: name: three_store_chain
# CHECK:       $r7 = ADDri3 killed $r7, 6, implicit-def dead $psw, implicit-def dead $c
# CHECK-NEXT:  $r7 = MOVmrPreDec killed $r7, $r1, implicit-def dead $psw
# CHECK-NEXT:  $r7 = MOVmrPreDec killed $r7, $r2, implicit-def dead $psw
# CHECK-NEXT:  $r7 = MOVmrPreDec killed $r7, $r3, implicit-def dead $psw
# CHECK-NEXT:  RETS implicit $r7
...
---
name:            live_base_high_store_chain
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r7

    MOVmr16 $r7, 6, $r1, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 4, $r2, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 2, $r3, implicit-def dead $psw :: (store (s16))
    RETS implicit $r7

# CHECK-LABEL: name: live_base_high_store_chain
# CHECK:       $r4 = MOVri4 8, implicit-def dead $psw
# CHECK-NEXT:  $r4 = ADDrr killed $r4, $r7, implicit-def dead $psw, implicit-def dead $c
# CHECK-NEXT:  $r4 = MOVmrPreDec killed $r4, $r1, implicit-def dead $psw
# CHECK-NEXT:  $r4 = MOVmrPreDec killed $r4, $r2, implicit-def dead $psw
# CHECK-NEXT:  dead $r4 = MOVmrPreDec killed $r4, $r3, implicit-def dead $psw
# CHECK-NEXT:  RETS implicit $r7
...
---
name:            four_store_chain
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r4, $r7

    MOVmr16 $r7, 6, $r1, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 4, $r2, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 2, $r3, implicit-def dead $psw :: (store (s16))
    MOVmr $r7, $r4, implicit-def $psw :: (store (s16))
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    RETS

  bb.2:
    RETS

# CHECK-LABEL: name: four_store_chain
# CHECK:       $r7 = ADDri16 killed $r7, 8, implicit-def dead $psw, implicit-def dead $c
# CHECK-NEXT:  $r7 = MOVmrPreDec killed $r7, $r1, implicit-def dead $psw
# CHECK-NEXT:  $r7 = MOVmrPreDec killed $r7, $r2, implicit-def dead $psw
# CHECK-NEXT:  $r7 = MOVmrPreDec killed $r7, $r3, implicit-def dead $psw
# CHECK-NEXT:  dead $r7 = MOVmrPreDec killed $r7, $r4, implicit-def $psw
# CHECK-NEXT:  JMPR_EQ %bb.2, implicit $psw
...
---
name:            permuted_store_chain
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r4, $r7

    MOVmr16 $r7, 4, $r1, implicit-def $psw :: (store (s16))
    MOVmr16 $r7, 6, $r2, implicit-def $psw :: (store (s16))
    MOVmr $r7, $r3, implicit-def $psw :: (store (s16))
    MOVmr16 $r7, 2, $r4, implicit-def $psw :: (store (s16))
    RETS implicit $r7

# CHECK-LABEL: name: permuted_store_chain
# CHECK:       $r7 = ADDri16 killed $r7, 8, implicit-def dead $psw, implicit-def dead $c
# CHECK-NEXT:  $r7 = MOVmrPreDec killed $r7, $r2, implicit-def dead $psw
# CHECK-NEXT:  $r7 = MOVmrPreDec killed $r7, $r1, implicit-def dead $psw
# CHECK-NEXT:  $r7 = MOVmrPreDec killed $r7, $r4, implicit-def dead $psw
# CHECK-NEXT:  $r7 = MOVmrPreDec killed $r7, $r3, implicit-def dead $psw
# CHECK-NEXT:  RETS implicit $r7
...
---
name:            store_chain_hoists_copy
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r4, $r5, $r7

    MOVmr16 $r7, 4, $r1, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 6, $r2, implicit-def dead $psw :: (store (s16))
    $r3 = MOVrr $r4, implicit-def dead $psw
    MOVmr $r7, $r3, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 2, $r5, implicit-def dead $psw :: (store (s16))
    RETS implicit $r7

# CHECK-LABEL: name: store_chain_hoists_copy
# CHECK:       $r7 = ADDri16 killed $r7, 8, implicit-def dead $psw, implicit-def dead $c
# CHECK-NEXT:  $r3 = MOVrr $r4, implicit-def dead $psw
# CHECK-NEXT:  $r7 = MOVmrPreDec killed $r7, $r2, implicit-def dead $psw
# CHECK-NEXT:  $r7 = MOVmrPreDec killed $r7, $r1, implicit-def dead $psw
# CHECK-NEXT:  $r7 = MOVmrPreDec killed $r7, $r5, implicit-def dead $psw
# CHECK-NEXT:  $r7 = MOVmrPreDec killed $r7, $r3, implicit-def dead $psw
# CHECK-NEXT:  RETS implicit $r7
...
---
name:            store_chain_keeps_overlapping_copy
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r2, $r3, $r4, $r5, $r7

    MOVmr16 $r7, 4, $r3, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 6, $r2, implicit-def dead $psw :: (store (s16))
    $r3 = MOVrr $r4, implicit-def dead $psw
    MOVmr $r7, $r3, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 2, $r5, implicit-def dead $psw :: (store (s16))
    RETS implicit $r7

# CHECK-LABEL: name: store_chain_keeps_overlapping_copy
# CHECK:       MOVmr16 $r7, 4, $r3
# CHECK-NEXT:  MOVmr16 $r7, 6, $r2
# CHECK-NEXT:  $r3 = MOVrr $r4
# CHECK-NEXT:  MOVmr $r7, $r3
# CHECK-NEXT:  MOVmr16 $r7, 2, $r5
# CHECK-NEXT:  RETS implicit $r7
...
---
name:            store_chain_keeps_base_copy
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r4, $r7

    MOVmr16 $r7, 4, $r1, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 6, $r2, implicit-def dead $psw :: (store (s16))
    $r3 = MOVrr $r7, implicit-def dead $psw
    MOVmr $r7, $r3, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 2, $r4, implicit-def dead $psw :: (store (s16))
    RETS implicit $r3, implicit $r7

# CHECK-LABEL: name: store_chain_keeps_base_copy
# CHECK:       MOVmr16 $r7, 4, $r1
# CHECK-NEXT:  MOVmr16 $r7, 6, $r2
# CHECK-NEXT:  $r3 = MOVrr $r7
# CHECK-NEXT:  MOVmr $r7, $r3
# CHECK-NEXT:  MOVmr16 $r7, 2, $r4
# CHECK-NEXT:  RETS implicit $r3, implicit $r7
...
---
name:            store_chain_keeps_trailing_copy
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r4, $r5, $r7

    MOVmr16 $r7, 4, $r1, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 6, $r2, implicit-def dead $psw :: (store (s16))
    MOVmr $r7, $r3, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 2, $r4, implicit-def dead $psw :: (store (s16))
    $r6 = MOVrr $r5, implicit-def dead $psw
    RETS implicit $r6, implicit $r7

# CHECK-LABEL: name: store_chain_keeps_trailing_copy
# CHECK:       $r7 = ADDri16 killed $r7, 8
# CHECK:       $r7 = MOVmrPreDec killed $r7, $r2
# CHECK:       $r7 = MOVmrPreDec killed $r7, $r1
# CHECK:       $r7 = MOVmrPreDec killed $r7, $r4
# CHECK:       $r7 = MOVmrPreDec killed $r7, $r3
# CHECK-NEXT:  $r6 = MOVrr $r5
# CHECK-NEXT:  RETS implicit $r6, implicit $r7
...
---
name:            permuted_store_chain_live_flags
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r4, $r7

    MOVmr16 $r7, 4, $r1, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 6, $r2, implicit-def dead $psw :: (store (s16))
    MOVmr $r7, $r3, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 2, $r4, implicit-def $psw :: (store (s16))
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    RETS

  bb.2:
    RETS

# CHECK-LABEL: name: permuted_store_chain_live_flags
# CHECK:       MOVmr16 $r7, 4, $r1
# CHECK-NEXT:  MOVmr16 $r7, 6, $r2
# CHECK-NEXT:  MOVmr $r7, $r3
# CHECK-NEXT:  MOVmr16 $r7, 2, $r4, implicit-def $psw
# CHECK-NEXT:  JMPR_EQ %bb.2, implicit $psw
...
---
name:            gapped_store_chain
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r7

    MOVmr16 $r7, 6, $r1, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 2, $r2, implicit-def dead $psw :: (store (s16))
    MOVmr $r7, $r3, implicit-def dead $psw :: (store (s16))
    RETS

# CHECK-LABEL: name: gapped_store_chain
# CHECK:       MOVmr16 $r7, 6, $r1
# CHECK-NEXT:  MOVmr16 $r7, 2, $r2
# CHECK-NEXT:  MOVmr $r7, $r3
...
---
name:            carry_live_store_chain
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r7, $c

    MOVmr16 $r7, 4, $r1, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 2, $r2, implicit-def dead $psw :: (store (s16))
    MOVmr $r7, $r3, implicit-def dead $psw :: (store (s16))
    RETS implicit $c

# CHECK-LABEL: name: carry_live_store_chain
# CHECK:       MOVmr16 $r7, 4, $r1
# CHECK-NEXT:  MOVmr16 $r7, 2, $r2
# CHECK-NEXT:  MOVmr $r7, $r3
...
---
name:            extended_store_chain
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r7, $r13

    EXTPr $r13, 3
    MOVmr16 $r7, 4, $r1, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 2, $r2, implicit-def dead $psw :: (store (s16))
    MOVmr $r7, $r3, implicit-def dead $psw :: (store (s16))
    RETS

# CHECK-LABEL: name: extended_store_chain
# CHECK:       EXTPr $r13, 3
# CHECK-NEXT:  MOVmr16 $r7, 4, $r1
# CHECK-NEXT:  MOVmr16 $r7, 2, $r2
# CHECK-NEXT:  MOVmr $r7, $r3
...
---
name:            base_source_store_chain
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r7

    MOVmr16 $r7, 4, $r7, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r7, 2, $r1, implicit-def dead $psw :: (store (s16))
    MOVmr $r7, $r2, implicit-def dead $psw :: (store (s16))
    RETS

# CHECK-LABEL: name: base_source_store_chain
# CHECK:       MOVmr16 $r7, 4, $r7
# CHECK-NEXT:  MOVmr16 $r7, 2, $r1
# CHECK-NEXT:  MOVmr $r7, $r2
...
---
name:            volatile_store_chain
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r7

    MOVmr16 $r7, 4, $r1, implicit-def dead $psw :: (volatile store (s16))
    MOVmr16 $r7, 2, $r2, implicit-def dead $psw :: (volatile store (s16))
    MOVmr $r7, $r3, implicit-def dead $psw :: (volatile store (s16))
    RETS

# CHECK-LABEL: name: volatile_store_chain
# CHECK:       MOVmr16 $r7, 4, $r1
# CHECK-NEXT:  MOVmr16 $r7, 2, $r2
# CHECK-NEXT:  MOVmr $r7, $r3
...
---
name:            stack_pointer_store_chain
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3

    MOVmr16 $r0, 4, $r1, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r0, 2, $r2, implicit-def dead $psw :: (store (s16))
    MOVmr $r0, $r3, implicit-def dead $psw :: (store (s16))
    RETS

# CHECK-LABEL: name: stack_pointer_store_chain
# CHECK:       MOVmr16 $r0, 4, $r1
# CHECK-NEXT:  MOVmr16 $r0, 2, $r2
# CHECK-NEXT:  MOVmr $r0, $r3
...
---
name:            frame_setup_store_chain
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r13, $r14

    $r0 = frame-setup SUBri16 $r0, 12, implicit-def dead $psw, implicit-def dead $c
    MOVmr16 $r0, 6, $r13, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r0, 8, $r14, implicit-def dead $psw :: (store (s16))
    RETS

# CHECK-LABEL: name: frame_setup_store_chain
# CHECK:       $r0 = frame-setup SUBri3 $r0, 2, implicit-def dead $psw, implicit-def dead $c
# CHECK-NEXT:  $r0 = frame-setup MOVmrPreDec $r0, $r14, implicit-def dead $psw
# CHECK-NEXT:  $r0 = frame-setup MOVmrPreDec $r0, $r13, implicit-def dead $psw
# CHECK-NEXT:  $r0 = frame-setup SUBri3 $r0, 6, implicit-def dead $psw, implicit-def dead $c
# CHECK-NEXT:  RETS
...
---
name:            frame_setup_store_chain_live_carry
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r13, $r14, $c

    $r0 = frame-setup SUBri16 $r0, 12, implicit-def dead $psw, implicit-def $c
    MOVmr16 $r0, 6, $r13, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r0, 8, $r14, implicit-def dead $psw :: (store (s16))
    JMPR_ULT %bb.2, implicit $psw, implicit $c

  bb.1:
    RETS

  bb.2:
    RETS

# CHECK-LABEL: name: frame_setup_store_chain_live_carry
# CHECK:       $r0 = frame-setup SUBri16 $r0, 12
# CHECK-NEXT:  MOVmr16 $r0, 6, $r13
# CHECK-NEXT:  MOVmr16 $r0, 8, $r14
# CHECK-NEXT:  JMPR_ULT
...
---
name:            frame_setup_store_chain_with_cfi
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r13, $r14

    $r0 = frame-setup SUBri16 $r0, 12, implicit-def dead $psw, implicit-def dead $c
    MOVmr16 $r0, 6, $r13, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r0, 8, $r14, implicit-def dead $psw :: (store (s16))
    RETS

# CHECK-LABEL: name: frame_setup_store_chain_with_cfi
# CHECK:       $r0 = frame-setup SUBri16 $r0, 12
# CHECK-NEXT:  MOVmr16 $r0, 6, $r13
# CHECK-NEXT:  MOVmr16 $r0, 8, $r14
# CHECK-NEXT:  RETS
...
---
name:            frame_setup_store_chain_no_saving
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r13

    $r0 = frame-setup SUBri16 $r0, 12, implicit-def dead $psw, implicit-def dead $c
    MOVmr16 $r0, 8, $r13, implicit-def dead $psw :: (store (s16))
    RETS

# CHECK-LABEL: name: frame_setup_store_chain_no_saving
# CHECK:       $r0 = frame-setup SUBri16 $r0, 12
# CHECK-NEXT:  MOVmr16 $r0, 8, $r13
# CHECK-NEXT:  RETS
...
---
name:            stack_pointer_high_offset_store_chain
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5, $r8, $r9

    MOVmr16 $r0, 34, $r8, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r0, 36, $r9, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r0, 38, $r4, implicit-def dead $psw :: (store (s16))
    MOVmr16 $r0, 40, $r5, implicit-def dead $psw :: (store (s16))
    RETS

# CHECK-LABEL: name: stack_pointer_high_offset_store_chain
# CHECK:       $r1 = MOVrr killed $r0, implicit-def dead $psw
# CHECK-NEXT:  $r1 = ADDri16 killed $r1, 42, implicit-def dead $psw, implicit-def dead $c
