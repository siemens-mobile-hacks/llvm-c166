  bb.0:
    successors: %bb.1
    liveins: $r0, $r1, $r6

    $r7 = MOVrm16 $r0, 2, implicit-def dead $psw :: (load (s16))
    $r6 = ADDrr killed $r6, killed $r1, implicit-def dead $psw, implicit-def dead $c, implicit $r7r6, implicit-def $r7r6
    JMPR_UC %bb.1

  bb.1:
    liveins: $r3, $r7r6

    $r7 = MOVrr killed $r3, implicit-def dead $psw
    RETS implicit $r7

# CHECK-LABEL: name: remove_dead_high_half_load_across_successor
# CHECK-NOT:   MOVrm16
# CHECK:       $r6 = ADDrr killed $r6, killed $r1
# CHECK:       $r7 = MOVrr killed $r3
...
