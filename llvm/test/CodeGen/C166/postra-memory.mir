    liveins: $r7

    $r1 = MOVrm $r7, implicit-def dead $psw :: (volatile load (s16))
    $r2 = MOVrm16 $r7, 2, implicit-def dead $psw :: (volatile load (s16))
    $r3 = MOVrm16 $r7, 4, implicit-def dead $psw :: (volatile load (s16))
    RETS implicit $r1, implicit $r2, implicit $r3

