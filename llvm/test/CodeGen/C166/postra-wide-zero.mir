# RUN: llc -mtriple=c166-none-elf -run-pass=c166-post-ra \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=c166-none-elf -run-pass=c166-post-ra \
# RUN:   -verify-machineinstrs -o %t.postra.mir %s
# RUN: llc -mtriple=c166-none-elf -start-after=c166-post-ra \
# RUN:   -verify-machineinstrs -filetype=obj -o %t.o %t.postra.mir
# RUN: llvm-objdump -d --no-show-raw-insn %t.o \
# RUN:   | FileCheck %s --check-prefix=OBJ

--- |
  target triple = "c166-none-elf"

  define void @fold_four_word_subtract_zero() { ret void }
  define void @fold_direct_four_word_zero() { ret void }
  define void @sink_local_stores_after_zero_branch() {
  entry:
    %local = alloca i64, align 2, addrspace(2)
    ret void
  }
  define void @sink_store_chain_after_zero_branch() {
  entry:
    %local = alloca i64, align 2, addrspace(2)
    ret void
  }
  define void @keep_local_stores_read_on_taken_path() {
  entry:
    %local = alloca i64, align 2, addrspace(2)
    ret void
  }
  define void @keep_local_stores_with_shared_fallthrough() {
  entry:
    %local = alloca i64, align 2, addrspace(2)
    ret void
  }
  define void @keep_unknown_zero_operand() { ret void }
  define void @keep_live_carry() { ret void }
  define void @fold_two_word_subtract_zero() { ret void }
...
---
name:            fold_four_word_subtract_zero
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8

    $r1, $c = SUBCarryrr $r1, killed $r5, implicit-def $psw
    $r2, $c = SUBCCarryrr $r2, killed $r6, killed $c, implicit-def $psw, implicit $psw
    $r3, $c = SUBCCarryrr $r3, killed $r7, killed $c, implicit-def $psw, implicit $psw
    $r4, dead $c = SUBCCarryrr $r4, killed $r8, killed $c, implicit-def dead $psw, implicit $psw
    MOVmr16 $r0, 2, $r1, implicit-def dead $psw :: (store (s16))
    $r9 = MOVrr $r4, implicit-def dead $psw
    $r9 = ORrr killed $r9, $r3, implicit-def dead $psw, implicit-def dead $c
    $r10 = MOVrr $r2, implicit-def dead $psw
    $r10 = ORrr killed $r10, killed $r9, implicit-def dead $psw, implicit-def dead $c
    $r10 = ORrr killed $r10, $r1, implicit-def dead $psw, implicit-def dead $c
    MOVmr16 $r0, 4, $r4, implicit-def dead $psw :: (store (s16))
    CMPri3 killed $r10, 0, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    RETS

  bb.2:
    RETS

# CHECK-LABEL: name: fold_four_word_subtract_zero
# CHECK:       $r4, dead $c = SUBCCarryrr
# CHECK-NEXT:  $r10 = BMOVPSWreg undef $r10, 0, 12, implicit-def dead $psw, implicit-def dead $c, implicit $psw
# CHECK-NEXT:  MOVmr16 $r0, 2, $r1
# CHECK-NEXT:  MOVmr16 $r0, 4, $r4
# CHECK-NEXT:  JBreg killed $r10, 0, %bb.2
# CHECK-NOT:   ORrr
# CHECK-NOT:   CMPri
# OBJ:         bmov r10.0, psw.12
# OBJ:         jb r10.0,
...
---
name:            fold_direct_four_word_zero
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8

    $r1, $c = SUBCarryrr $r1, killed $r5, implicit-def $psw
    $r2, $c = SUBCCarryrr $r2, killed $r6, killed $c, implicit-def $psw, implicit $psw
    $r3, $c = SUBCCarryrr $r3, killed $r7, killed $c, implicit-def $psw, implicit $psw
    $r4, dead $c = SUBCCarryrr $r4, killed $r8, killed $c, implicit-def dead $psw, implicit $psw
    MOVmr16 $r0, 2, $r1, implicit-def dead $psw :: (store (s16))
    $r9 = MOVrr $r4, implicit-def dead $psw
    $r9 = ORrr killed $r9, $r2, implicit-def dead $psw, implicit-def dead $c
    $r10 = MOVrr $r3, implicit-def dead $psw
    $r10 = ORrr killed $r10, killed $r9, implicit-def dead $psw, implicit-def dead $c
    $r10 = ORrr killed $r10, $r1, implicit-def $psw, implicit-def dead $c
    JMPR_NE %bb.2, implicit $psw

  bb.1:
    RETS

  bb.2:
    RETS

# CHECK-LABEL: name: fold_direct_four_word_zero
# CHECK:       $r4, dead $c = SUBCCarryrr
# CHECK-NEXT:  $r10 = BMOVPSWreg undef $r10, 0, 12, implicit-def dead $psw, implicit-def dead $c, implicit $psw
# CHECK-NEXT:  MOVmr16 $r0, 2, $r1
# CHECK-NEXT:  JNBreg killed $r10, 0, %bb.2
# CHECK-NOT:   ORrr
...
---
name:            sink_local_stores_after_zero_branch
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8

    $r1, $c = SUBCarryrr $r1, killed $r5, implicit-def $psw
    $r2, $c = SUBCCarryrr $r2, killed $r6, killed $c, implicit-def $psw, implicit $psw
    $r3, $c = SUBCCarryrr $r3, killed $r7, killed $c, implicit-def $psw, implicit $psw
    $r4, dead $c = SUBCCarryrr $r4, killed $r8, killed $c, implicit-def dead $psw, implicit $psw
    MOVmr16 $r0, 0, $r1, implicit-def dead $psw :: (store (s16) into %ir.local, addrspace 2)
    $r9 = MOVrr $r4, implicit-def dead $psw
    $r9 = ORrr killed $r9, $r3, implicit-def dead $psw, implicit-def dead $c
    $r10 = MOVrr $r2, implicit-def dead $psw
    $r10 = ORrr killed $r10, killed $r9, implicit-def dead $psw, implicit-def dead $c
    $r10 = ORrr killed $r10, $r1, implicit-def dead $psw, implicit-def dead $c
    CMPri3 killed $r10, 0, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    RETS

  bb.2:
    RETS

# CHECK-LABEL: name: sink_local_stores_after_zero_branch
# CHECK:       $r4, dead $c = SUBCCarryrr
# CHECK-NEXT:  JMPR_EQ %bb.2
# CHECK:       bb.1:
# CHECK:       liveins: $r1
# CHECK:       MOVmr16 $r0, 0, $r1
# CHECK-NOT:   BMOVPSWreg
# CHECK-NOT:   ORrr
# CHECK-NOT:   CMPri
...
---
name:            sink_store_chain_after_zero_branch
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8

    $r1, $c = SUBCarryrr $r1, killed $r5, implicit-def $psw
    $r2, $c = SUBCCarryrr $r2, killed $r6, killed $c, implicit-def $psw, implicit $psw
    $r3, $c = SUBCCarryrr $r3, killed $r7, killed $c, implicit-def $psw, implicit $psw
    $r4, dead $c = SUBCCarryrr $r4, killed $r8, killed $c, implicit-def dead $psw, implicit $psw
    MOVmr $r0, $r1, implicit-def dead $psw :: (store (s16) into %ir.local, addrspace 2)
    MOVmr16 $r0, 2, $r2, implicit-def dead $psw :: (store (s16) into %ir.local, addrspace 2)
    $r9 = MOVrr $r4, implicit-def dead $psw
    $r9 = ORrr killed $r9, $r3, implicit-def dead $psw, implicit-def dead $c
    $r10 = MOVrr $r2, implicit-def dead $psw
    $r10 = ORrr killed $r10, killed $r9, implicit-def dead $psw, implicit-def dead $c
    $r10 = ORrr killed $r10, $r1, implicit-def dead $psw, implicit-def dead $c
    MOVmr16 $r0, 4, $r3, implicit-def dead $psw :: (store (s16) into %ir.local, addrspace 2)
    MOVmr16 $r0, 6, $r4, implicit-def dead $psw :: (store (s16) into %ir.local, addrspace 2)
    CMPri3 killed $r10, 0, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    RETS

  bb.2:
    RETS

# CHECK-LABEL: name: sink_store_chain_after_zero_branch
# CHECK:       $r4, dead $c = SUBCCarryrr
# CHECK-NEXT:  JMPR_EQ %bb.2
# CHECK:       bb.1:
# CHECK:       liveins: $r1, $r2, $r3, $r4
# CHECK:       $r5 = MOVri4 8, implicit-def dead $psw
# CHECK-NEXT:  $r5 = ADDrr killed $r5, killed $r0, implicit-def dead $psw, implicit-def dead $c
# CHECK-NEXT:  $r5 = MOVmrPreDec killed $r5, $r4, implicit-def dead $psw
# CHECK-NEXT:  $r5 = MOVmrPreDec killed $r5, $r3, implicit-def dead $psw
# CHECK-NEXT:  $r5 = MOVmrPreDec killed $r5, $r2, implicit-def dead $psw
# CHECK-NEXT:  dead $r5 = MOVmrPreDec killed $r5, $r1, implicit-def dead $psw
# CHECK-NOT:   ORrr
# CHECK-NOT:   CMPri
...
---
name:            keep_local_stores_read_on_taken_path
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8

    $r1, $c = SUBCarryrr $r1, killed $r5, implicit-def $psw
    $r2, $c = SUBCCarryrr $r2, killed $r6, killed $c, implicit-def $psw, implicit $psw
    $r3, $c = SUBCCarryrr $r3, killed $r7, killed $c, implicit-def $psw, implicit $psw
    $r4, dead $c = SUBCCarryrr $r4, killed $r8, killed $c, implicit-def dead $psw, implicit $psw
    MOVmr16 $r0, 0, $r1, implicit-def dead $psw :: (store (s16) into %ir.local, addrspace 2)
    $r9 = MOVrr $r4, implicit-def dead $psw
    $r9 = ORrr killed $r9, $r3, implicit-def dead $psw, implicit-def dead $c
    $r10 = MOVrr $r2, implicit-def dead $psw
    $r10 = ORrr killed $r10, killed $r9, implicit-def dead $psw, implicit-def dead $c
    $r10 = ORrr killed $r10, $r1, implicit-def dead $psw, implicit-def dead $c
    CMPri3 killed $r10, 0, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    RETS

  bb.2:
    $r11 = MOVrm16 $r0, 0, implicit-def dead $psw :: (load (s16) from %ir.local, addrspace 2)
    RETS implicit $r11

# CHECK-LABEL: name: keep_local_stores_read_on_taken_path
# CHECK:       $r4, dead $c = SUBCCarryrr
# CHECK-NEXT:  $r10 = BMOVPSWreg
# CHECK-NEXT:  MOVmr16 $r0, 0, $r1
# CHECK-NEXT:  JBreg killed $r10, 0, %bb.2
# CHECK:       bb.2:
# CHECK:       $r11 = MOVrm16 $r0, 0
# CHECK-NOT:   ORrr
# CHECK-NOT:   CMPri
...
---
name:            keep_local_stores_with_shared_fallthrough
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8

    $r1, $c = SUBCarryrr $r1, killed $r5, implicit-def $psw
    $r2, $c = SUBCCarryrr $r2, killed $r6, killed $c, implicit-def $psw, implicit $psw
    $r3, $c = SUBCCarryrr $r3, killed $r7, killed $c, implicit-def $psw, implicit $psw
    $r4, dead $c = SUBCCarryrr $r4, killed $r8, killed $c, implicit-def dead $psw, implicit $psw
    MOVmr16 $r0, 0, $r1, implicit-def dead $psw :: (store (s16) into %ir.local, addrspace 2)
    $r9 = MOVrr $r4, implicit-def dead $psw
    $r9 = ORrr killed $r9, $r3, implicit-def dead $psw, implicit-def dead $c
    $r10 = MOVrr $r2, implicit-def dead $psw
    $r10 = ORrr killed $r10, killed $r9, implicit-def dead $psw, implicit-def dead $c
    $r10 = ORrr killed $r10, $r1, implicit-def dead $psw, implicit-def dead $c
    CMPri3 killed $r10, 0, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    RETS

  bb.2:
    RETS

  bb.3:
    successors: %bb.1
    JMPR_UC %bb.1

# CHECK-LABEL: name: keep_local_stores_with_shared_fallthrough
# CHECK:       $r4, dead $c = SUBCCarryrr
# CHECK-NEXT:  $r10 = BMOVPSWreg
# CHECK-NEXT:  MOVmr16 $r0, 0, $r1
# CHECK-NEXT:  JBreg killed $r10, 0, %bb.2
# CHECK-NOT:   ORrr
# CHECK-NOT:   CMPri
...
---
name:            keep_unknown_zero_operand
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r3, $r4, $r5

    $r1, $c = SUBCarryrr $r1, killed $r3, implicit-def $psw
    $r2, dead $c = SUBCCarryrr $r2, killed $r4, killed $c, implicit-def dead $psw, implicit $psw
    $r6 = MOVrr $r2, implicit-def dead $psw
    $r6 = ORrr killed $r6, $r1, implicit-def dead $psw, implicit-def dead $c
    $r6 = ORrr killed $r6, killed $r5, implicit-def dead $psw, implicit-def dead $c
    CMPri3 killed $r6, 0, implicit-def $psw, implicit-def dead $c
    JMPR_NE %bb.2, implicit $psw

  bb.1:
    RETS

  bb.2:
    RETS

# CHECK-LABEL: name: keep_unknown_zero_operand
# CHECK:       $r6 = MOVrr $r2
# CHECK-NEXT:  $r6 = ORrr killed $r6, $r1
# CHECK-NEXT:  dead $r6 = ORrr killed $r6, killed $r5
# CHECK-NEXT:  JMPR_NE %bb.2
...
---
name:            keep_live_carry
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r3, $r4

    $r1, $c = SUBCarryrr $r1, killed $r3, implicit-def $psw
    $r2, $c = SUBCCarryrr $r2, killed $r4, killed $c, implicit-def dead $psw, implicit $psw
    $r5 = MOVrr $r2, implicit-def dead $psw
    $r5 = ORrr killed $r5, $r1, implicit-def dead $psw, implicit-def dead $c
    CMPri3 killed $r5, 0, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    liveins: $c
    RETS implicit $c

  bb.2:
    liveins: $c
    RETS implicit $c

# CHECK-LABEL: name: keep_live_carry
# CHECK:       $r2, $c = SUBCCarryrr
# CHECK:       CMPri3 killed $r5, 0
# CHECK-NEXT:  JMPR_EQ %bb.2
...
---
name:            fold_two_word_subtract_zero
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r3, $r4

    $r1, $c = SUBCarryrr $r1, killed $r3, implicit-def $psw
    $r2, dead $c = SUBCCarryrr $r2, killed $r4, killed $c, implicit-def dead $psw, implicit $psw
    $r5 = MOVrr $r2, implicit-def dead $psw
    $r5 = ORrr killed $r5, $r1, implicit-def dead $psw, implicit-def dead $c
    CMPri3 killed $r5, 0, implicit-def $psw, implicit-def dead $c
    JMPR_EQ %bb.2, implicit $psw

  bb.1:
    RETS

  bb.2:
    RETS

# CHECK-LABEL: name: fold_two_word_subtract_zero
# CHECK:       $r2, dead $c = SUBCCarryrr
# CHECK-NEXT:  JMPR_EQ %bb.2
# CHECK-NOT:   MOVrr
# CHECK-NOT:   ORrr
...
