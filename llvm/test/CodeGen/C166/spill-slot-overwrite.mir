# RUN: llc -mtriple=c166-none-elf -run-pass=c166-post-ra -verify-machineinstrs -o - %s | FileCheck %s

--- |
  declare void @callee() addrspace(1)
  define void @overwritten() optsize { ret void }
  define void @branch_read() optsize { ret void }
  define void @loop_read() optsize { ret void }
...
---
name: overwritten
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0:
    liveins: $r0, $r14
    ; CHECK-LABEL: name: overwritten
    ; CHECK-NOT: MOVmr16 $r0, 8, $r14
    ; CHECK: CALLS
    ; CHECK: MOVmr16 $r0, 8, $r15
    MOVmr16 $r0, 8, $r14, implicit-def dead $psw :: (store (s16) into %stack.0)
    CALLS @callee, @callee, csr_c166_callpreserved
    JMPR_UC %bb.1
  bb.1:
    liveins: $r0
    $r15 = MOVri4 2, implicit-def dead $psw
    MOVmr16 $r0, 8, $r15, implicit-def dead $psw :: (store (s16) into %stack.0)
    CALLS @callee, @callee, csr_c166_callpreserved
    JMPR_UC %bb.2
  bb.2:
    liveins: $r0
    $r4 = MOVrm16 $r0, 8, implicit-def dead $psw :: (load (s16) from %stack.0)
    RETS implicit $r4
...
---
name: branch_read
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0:
    liveins: $r0, $r14
    ; CHECK-LABEL: name: branch_read
    ; CHECK: MOVmr16 $r0, 8, $r14
    MOVmr16 $r0, 8, $r14, implicit-def dead $psw :: (store (s16) into %stack.0)
    CALLS @callee, @callee, csr_c166_callpreserved
    $r4 = MOVri4 0, implicit-def dead $psw
    CMPri3 $r4, 0, implicit-def $psw, implicit-def $c
    JMPR_EQ %bb.2, implicit $psw
    JMPR_UC %bb.1
  bb.1:
    liveins: $r0
    $r15 = MOVri4 2, implicit-def dead $psw
    MOVmr16 $r0, 8, $r15, implicit-def dead $psw :: (store (s16) into %stack.0)
    CALLS @callee, @callee, csr_c166_callpreserved
    JMPR_UC %bb.2
  bb.2:
    liveins: $r0
    $r4 = MOVrm16 $r0, 8, implicit-def dead $psw :: (load (s16) from %stack.0)
    RETS implicit $r4
...
---
name: loop_read
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0:
    liveins: $r0, $r14
    ; CHECK-LABEL: name: loop_read
    ; CHECK: MOVmr16 $r0, 8, $r14
    MOVmr16 $r0, 8, $r14, implicit-def dead $psw :: (store (s16) into %stack.0)
    CALLS @callee, @callee, csr_c166_callpreserved
    JMPR_UC %bb.1
  bb.1:
    liveins: $r0
    $r4 = MOVri4 0, implicit-def dead $psw
    CMPri3 $r4, 0, implicit-def $psw, implicit-def $c
    JMPR_EQ %bb.1, implicit $psw
    JMPR_UC %bb.2
  bb.2:
    liveins: $r0
    $r4 = MOVrm16 $r0, 8, implicit-def dead $psw :: (load (s16) from %stack.0)
    RETS implicit $r4
...
