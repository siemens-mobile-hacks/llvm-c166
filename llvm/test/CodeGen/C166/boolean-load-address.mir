# RUN: llc -mtriple=c166-none-elf -run-pass=c166-post-ra -verify-machineinstrs -o - %s | FileCheck %s

# CHECK: $r4 = MOVri4 1
# CHECK: $r8 = ADDri3
# CHECK: $r5 = MOVrm $r8
# CHECK: ORrr

--- |
  define void @boolean_load_address() { ret void }
...
---
name: boolean_load_address
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r8
    $r4 = MOVri4 1, implicit-def dead $psw
    $r8 = ADDri3 $r8, 2, implicit-def $psw, implicit-def $c
    JMPR_ULT %bb.2, implicit $psw, implicit $c
  bb.1:
    successors: %bb.2
    liveins: $r8
    $r4 = MOVri4 0, implicit-def dead $psw
  bb.2:
    liveins: $r4, $r8
    $r5 = MOVrm $r8, implicit-def dead $psw
    $r5 = ORrr killed $r5, killed $r4, implicit-def dead $psw, implicit-def dead $c
    RETS implicit $r5
...
